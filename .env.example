# Hepsi isteğe bağlı. Netlify > Site configuration > Environment variables bölümüne ekle.
# Hiçbiri tanımlı değilse panel yine çalışır, sadece bildirim gönderilmez.

# --- Bildirim kanalları ---
# ntfy.sh konusu. Tahmin edilmesi zor, uzun bir ad seç: konuyu bilen herkes okuyup yazabilir.
NTFY_TOPIC=
# Kendi ntfy sunucun varsa (varsayılan https://ntfy.sh)
NTFY_SERVER=
# Korumalı ntfy konuları için erişim jetonu
NTFY_TOKEN=
# Google Chat gelen webhook adresi
GOOGLE_CHAT_WEBHOOK_URL=
# Genel webhook. { title, body, text, priority, kind, url } gönderilir
WEBHOOK_URL=

# --- Hangi olaylar için bildirim? Boşsa hepsi. Virgülle ayır ---
WATCH_REGIONS=eu-central-1,us-east-1
WATCH_SERVICES=eks,rds,s3
# Bilgilendirme düzeyindeki AWS duyuruları için de bildirim gönder
ALERT_INFO=false
# Bildirim dili: tr | en
ALERT_LANG=tr

# --- Canlı erişim testleri (kapatmak için PROBE_REGIONS=off) ---
PROBE_REGIONS=us-east-1,us-east-2,us-west-2,eu-west-1,eu-central-1,ap-southeast-1,ap-northeast-1,sa-east-1
PROBE_SERVICES=dynamodb,sts,s3,ec2
PROBE_TIMEOUT_MS=5000
PROBE_SLOW_MS=2500

# --- Diğer ---
# Bir olay, son güncellemesinden sonra kaç saat "aktif" sayılsın
ACTIVE_HOURS=48
# DownDetector sinyalini kapatmak için: off
DOWNDETECTOR=on
# Bildirimlerdeki bağlantı için Netlify'ın URL değişkeni otomatik kullanılır.
